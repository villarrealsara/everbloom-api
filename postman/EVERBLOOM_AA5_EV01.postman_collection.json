  "item": [
    {
      "name": "0. Salud",
      "item": [
        {
          "name": "GET salud de la API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "salud"
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"La respuesta es JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"estado es ok\", function () { pm.expect(pm.response.json().estado).to.eql(\"ok\"); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Registro",
      "item": [
        {
          "name": "POST registro - exitoso (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "registro"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Sara\",\n  \"apellidos\": \"Villarreal\",\n  \"correo\": \"{{correo}}\",\n  \"contrasena\": \"clave123\",\n  \"telefono\": \"3001234567\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"correo\", \"sara.\" + Date.now() + \"@everbloom.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"La respuesta es JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"devuelve el usuario sin contraseña\", function () { var j = pm.response.json(); pm.expect(j.usuario.correo).to.eql(pm.collectionVariables.get(\"correo\")); pm.expect(j.usuario).to.not.have.property(\"contrasena\"); });"
                ]
              }
            }
          ]
        },
