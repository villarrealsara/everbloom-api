{
  "info": {
    "name": "EVERBLOOM API - AA5-EV01",
    "description": "Colección de pruebas de la API de registro e inicio de sesión. Aprendiz: Sara Julieth Villarreal Ortiz.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
